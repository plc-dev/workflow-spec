{
  "irVersion": 2,
  "name": "literal-and-single-step-branch-example",
  "steps": [
    {
      "id": "agentRun",
      "service": "registry.internal/agent-runner@sha256:beef000000000000000000000000000000000000000000000000000000000001",
      "function": "run",
      "reads": {
        "allowedTools": {
          "literal": [
            {
              "service": "registry.internal/enrich@sha256:cafe000000000000000000000000000000000000000000000000000000000001",
              "function": "enrich"
            }
          ]
        },
        "maxDepth": { "literal": 3 }
      }
    },
    {
      "id": "gate",
      "kind": "branch",
      "selector": {
        "compute": { "==": [{ "var": "ok" }, true] },
        "using": {
          "ok": { "from": "step", "id": "agentRun", "output": "succeeded" }
        }
      },
      "cases": {
        "true": {
          "steps": [
            {
              "id": "acceptStep",
              "service": "registry.internal/accept@sha256:d00d000000000000000000000000000000000000000000000000000000000001",
              "function": "accept"
            }
          ]
        },
        "false": {
          "steps": [
            {
              "id": "rejectStep",
              "service": "registry.internal/reject@sha256:d00d000000000000000000000000000000000000000000000000000000000002",
              "function": "reject"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "outcome": { "from": "step", "id": "gate", "output": "result" }
  }
}
