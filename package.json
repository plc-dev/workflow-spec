{
  "name": "wfx",
  "version": "0.1.0",
  "private": true,
  "description": "Workflow execution platform - single Node/TypeScript package (ADR-0001).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write ./src",
    "lint": "biome lint ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --silent",
    "prepare": "git config --local core.hooksPath .git_hooks || echo \"Git not found or not a repository, skipping...\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.10",
    "testcontainers": "^12.0.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
