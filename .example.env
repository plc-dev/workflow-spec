# Copy to `.env` for local development. Every variable here is read
# exclusively by `src/shared/config.ts` (ADR-0009, path per ADR-0012) - no
# other module reads `process.env` directly. Kept in sync by hand with
# that file's zod schema; see
# docs/impl-plans/implementation-best-practices.md §5.

# Optional. One of: fatal, error, warn, info, debug, trace, silent.
# Defaults to "info" if unset.
LOG_LEVEL=info

# Postgres connection: NOT read via src/shared/config.ts (see
# src/apps/worker/config.ts's own comment for why - shared/config.ts's
# singleton is parsed eagerly at import time, which would fail closed for
# every module that merely imports core/engine/etc without ever opening a
# real connection). Read by apps/worker/config.ts, at that app's own
# explicit startup (main.ts). `docker-compose.dev.yml` stands up a local
# Postgres on wfx/wfx@localhost:5432/core.

# apps/worker (docs/impl-plans/0011-worker-cli-dispatch.md) - every
# variable below is read exclusively by src/apps/worker/config.ts, kept in
# sync by hand with that file's zod schema, same posture as this file's
# header note for src/shared/config.ts.

# Required. Postgres connection string for core/'s consolidated database.
DATABASE_URL=postgres://wfx:wfx@localhost:5432/core

# Required. Base URL of the in-pod exec-agent's HTTP endpoint this worker
# dispatches every step to. Deliberately a SINGLE static endpoint in this
# package - see 0011's "Addressing gap" section for why real placement-
# aware, per-replica addressing is not yet implemented.
AGENT_INVOKE_BASE_URL=http://127.0.0.1:9464

# Optional. Sent as `Authorization: Bearer <token>` on every request to
# the agent, matching the agent's own optional AGENT_AUTH_TOKEN (see
# agent/.example.env or docs/adr/0008). Leave unset when the agent runs
# with auth disabled.
AGENT_AUTH_TOKEN=

# Optional. Defaults to `<hostname>:<pid>` if unset.
WORKER_ID=

# Optional. Positive integer (seconds). Defaults to 30.
CLAIM_LEASE_SECONDS=30

# Optional. Positive integer (milliseconds). Defaults to 30000.
INVOKE_TIMEOUT_MS=30000

# Optional. Positive integer (milliseconds). Defaults to 250.
POLL_INTERVAL_MS=250
